# Шаблон переменных окружения
# Скопируйте в .env и заполните значения

# Anthropic Messages API. Получить: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель и лимиты
ANTHROPIC_MODEL=claude-haiku-4-5
MAX_SEARCH_USES=4
MAX_OUTPUT_TOKENS=2048

# Контроль расхода. MAX_DAILY_CALLS — жёсткий предел HTTP-вызовов /v1/messages
# в сутки, то есть витков, а не пользовательских запросов: один дайджест при
# MAX_SEARCH_USES=4 берёт до пяти витков. 50 витков ≈ 10 дайджестов в сутки.
MAX_DAILY_CALLS=50
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_PER_HOUR=30
CACHE_TTL_HOURS=6

# Сервер
PORT=8080
PUBLIC_HOSTNAME=

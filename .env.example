# Шаблон переменных окружения
# Скопируйте в .env и заполните значения

# Anthropic Messages API. Получить: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель и лимиты
ANTHROPIC_MODEL=claude-haiku-4-5
MAX_SEARCH_USES=4
MAX_OUTPUT_TOKENS=2048

# Контроль расхода. MAX_DAILY_CALLS — жёсткий предел HTTP-вызовов /v1/messages
# в сутки. Поиски идут внутри вызова, поэтому 50 вызовов — это до 50 дайджестов.
# Измерено спайком 2026-09-07: дайджест стоит $0.112, то есть 50 вызовов —
# около $5.60/сут. Токеновая часть этим лимитом не ограничена: при полном окне
# контекста вызов доходит до ~$0.25, то есть ~$12.50/сут. Потолок в деньгах
# даёт только биллинг-алерт.
MAX_DAILY_CALLS=50
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_PER_HOUR=30
CACHE_TTL_HOURS=6

# Сервер
PORT=8080
PUBLIC_HOSTNAME=

# Шаблон переменных окружения
# Скопируйте в .env и заполните значения

# Anthropic Messages API. Получить: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель и лимиты
ANTHROPIC_MODEL=claude-sonnet-5
MAX_SEARCH_USES=4
MAX_OUTPUT_TOKENS=2048

# Контроль расхода. MAX_DAILY_CALLS — жёсткий предел вызовов API в сутки.
MAX_DAILY_CALLS=50
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_PER_HOUR=30
CACHE_TTL_HOURS=6

# Сервер
PORT=8080
PUBLIC_HOSTNAME=

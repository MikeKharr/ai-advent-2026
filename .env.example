# Шаблон переменных окружения
# Скопируйте в .env и заполните значения

# Anthropic Messages API. Получить: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Модель и лимиты
ANTHROPIC_MODEL=claude-haiku-4-5
MAX_SEARCH_USES=4
MAX_OUTPUT_TOKENS=2048

# Контроль расхода. MAX_DAILY_CALLS — жёсткий предел HTTP-вызовов /v1/messages
# в сутки. Цикл web_search крутится внутри одного вызова, поэтому дайджест — это
# обычно один вызов; второй возникает лишь изредка, при stop_reason=pause_turn.
# То есть 50 ≈ 50 дайджестов в сутки, а поисков до 50 × MAX_SEARCH_USES.
MAX_DAILY_CALLS=50
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_PER_HOUR=30
CACHE_TTL_HOURS=6

# Сервер
PORT=8080
PUBLIC_HOSTNAME=

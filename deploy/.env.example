# Файл deploy/.env — теги образов. Переписывается workflow деплоя.
# Скопируйте в deploy/.env при первичной настройке.

DAY1_TAG=latest

# Секреты приложений живут в отдельных файлах deploy/dayN.env,
# они в .gitignore и создаются вручную на сервере. Пример для дня 1:
#
#   deploy/day1.env
#     ANTHROPIC_API_KEY=sk-ant-...
#     ANTHROPIC_MODEL=claude-sonnet-5
#     MAX_DAILY_CALLS=50

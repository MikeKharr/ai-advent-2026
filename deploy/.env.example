# Файл deploy/.env — теги образов. Переписывается workflow деплоя.
# Скопируйте в deploy/.env при первичной настройке.

DAY1_TAG=latest
DAY2_TAG=latest
DAY3_TAG=latest
DAY4_TAG=latest
DAY5_TAG=latest
DAY6_TAG=latest
DAY7_TAG=latest
DAY8_TAG=latest
ROUTER_TAG=latest
AGENTS_TAG=latest
ATLAS_TAG=latest

# Секреты приложений живут в отдельных файлах, они в .gitignore
# и создаются на сервере — никогда в репозитории.
#
#   deploy/secrets.env — общий для всех дней, кладётся один раз:
#     ANTHROPIC_API_KEY=sk-ant-...
#     ANTHROPIC_MODEL=claude-haiku-4-5
#     MAX_DAILY_CALLS=50
#
#   deploy/dayN.env — только то, что специфично для дня N (обычно не нужен).
#   Переопределяет значения из secrets.env.
#
#   deploy/day5.env — день 5 ходит в роутер, своих ключей к моделям не имеет:
#     ROUTER_APP_KEY=<то же значение, что APP_KEY_DAY5 в router.env>
#
#   deploy/router.env — сервис роутера (ADR 2026-09-08-1748): ключи провайдеров
#   и ключи приложений. Имена переменных задаёт router/config/*.json (secretEnv).
#   Ключи всех трёх облачных провайдеров обязательны: роутер проверяет их на
#   старте и падает на первом отсутствующем, ещё до открытия порта
#   (router/src/config.js, validateProviders). Порядок заведения ключей —
#   agent_docs/operations.md, «Добавить или подключить провайдера»:
#     ANTHROPIC_API_KEY=<ключ с console.anthropic.com>
#     GROQ_API_KEY=<ключ с console.groq.com; страж промптов и генеративные
#                   модели Groq дня 5>
#     KIMI_API_KEY=<ключ с platform.kimi.ai; модели Kimi, которые политика
#                   сама не берёт — только по явному выбору приложения,
#                   ADR 2026-09-15-1448>
#     ROUTER_ADMIN_KEY=<длинная случайная строка, для /v1/spend и /v1/metrics>
#     APP_KEY_SMOKE=<ключ приложения smoke>
#     APP_KEY_DAY5=<ключ приложения day5; он же ROUTER_APP_KEY в day5.env>
#     APP_KEY_AGENTS=<ключ приложения agents; он же ROUTER_APP_KEY в agents.env>
#   Без файла роутер падает на старте (нет секретов); дни поднимаются как обычно.
#
#   deploy/agents.env — сервис агентов (ADR 2026-09-09-0854):
#     AGENT_KEY=<ключ сервиса; его же предъявляет день 6>
#     ROUTER_APP_KEY=<то же значение, что APP_KEY_AGENTS в router.env>
#
#   deploy/day6.env — день 6 ходит только к агенту, ключа роутера не имеет:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#
#   deploy/day7.env — день 7, тот же ключ агента плюс путь cookie сессии:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#     COOKIE_PATH=/day7/
#
#   deploy/day8.env — день 8, то же самое со своим путём:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#     COOKIE_PATH=/day8/
#
#   deploy/day13.env — день 13 (ADR 2026-09-21-1747), как дни 9–11: тот же
#   ключ сервиса агентов и больше ничего. COOKIE_PATH здесь не нужен —
#   умолчание дня уже /day13/ (days/day13/env.js). Журнал этапов CSV и срок
#   паузы — переменные сервиса агентов (STAGE_LOG_FILE, PAUSE_TTL_MINUTES),
#   их умолчания в коде верны для прода, объявлять их в deploy не нужно:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#
#   deploy/day14.env — день 14 (ADR 2026-09-22-0827), устроен как день 13:
#   тот же ключ сервиса агентов и больше ничего. COOKIE_PATH не нужен —
#   умолчание дня уже /day14/ (days/day14/env.js). Ключ подписи билетов
#   формулировщика сервис агентов создаёт случайно при старте и нигде не
#   хранит: нового секрета день 14 не заводит:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#
# Положить или обновить общий файл: bash deploy/put-secrets.sh

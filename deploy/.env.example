# Файл deploy/.env — теги образов. Переписывается workflow деплоя.
# Скопируйте в deploy/.env при первичной настройке.
#
# Строк единиц дней, атласа, mcpnews и mcpstore здесь больше нет: приложения
# дней свёрнуты в архив, а эти службы удалены (ADR 2026-10-20-0737). Если на
# сервере в deploy/.env остались строки DAY*_TAG, ATLAS_TAG, MCPNEWS_TAG или
# MCPSTORE_TAG — они мёртвые: compose их не читает. Уборка — шаг владельца,
# команда в development-history/2026-10-20-0810-retire-challenge-days.md.

ROUTER_TAG=latest
AGENTS_TAG=latest
MCP_TAG=latest
# У службы ollama строки нет и не будет: образ прибит по digest в
# compose.yml, а не тегом из этого файла — она не единица выкатки.
RAG_TAG=latest

# Секреты служб живут в отдельных файлах, они в .gitignore и создаются на
# сервере — никогда в репозитории. Живых файлов ровно четыре, по одному на
# службу, которая читает секрет: router.env, agents.env, mcp.env, rag.env.
# Файлов secrets.env, cron.env и dayN.env в проекте больше нет — их не читает
# ни одна служба (ADR 2026-10-20-0737).
#
#   deploy/router.env — сервис роутера (ADR 2026-09-08-1748): ключи провайдеров
#   и ключи приложений. Имена переменных задаёт router/config/*.json (secretEnv).
#   Ключи всех трёх облачных провайдеров обязательны: роутер проверяет их на
#   старте и падает на первом отсутствующем, ещё до открытия порта
#   (router/src/config.js, validateProviders). Порядок заведения ключей —
#   agent_docs/operations.md, «Добавить или подключить провайдера»:
#     ANTHROPIC_API_KEY=<ключ с console.anthropic.com>
#     GROQ_API_KEY=<ключ с console.groq.com; страж промптов и генеративные
#                   модели Groq>
#     KIMI_API_KEY=<ключ с platform.kimi.ai; модели Kimi, которые политика
#                   сама не берёт — только по явному выбору приложения,
#                   ADR 2026-09-15-1448>
#     ROUTER_ADMIN_KEY=<длинная случайная строка, для /v1/spend и /v1/metrics>
#     APP_KEY_SMOKE=<ключ приложения smoke>
#     APP_KEY_DAY5=<ключ приложения day5. ПРИЛОЖЕНИЯ БОЛЬШЕ НЕТ, а ключ
#                   обязателен: запись `day5` оставлена в
#                   router/config/apps.json, потому что держит контрольную
#                   ветвь router/test/config.test.js, а роутер падает на
#                   старте без ключа любой объявленной записи. То есть это
#                   ключ без потребителя в проде; убрать его можно только
#                   вместе с записью и переписанной контрольной ветвью —
#                   пункт владельцу в agent_docs/backlog/process.md
#                   (ADR 2026-10-20-0737).>
#     APP_KEY_AGENTS=<ключ приложения agents; он же ROUTER_APP_KEY в agents.env>
#   Без файла роутер падает на старте (нет секретов); остальные службы
#   поднимаются как обычно.
#
#   Строки APP_KEY_SCHEDULER в живом составе нет: приложение `scheduler`
#   оплачивало запуски планировщика дня 18, а работ в проекте не осталось —
#   файла agents/config/jobs.json нет (ADR 2026-10-20-0737). Если строка
#   лежит на сервере, она мёртвая и роутеру не мешает: записи `scheduler` в
#   apps.json нет, лишнюю переменную окружения он не читает.
#
#   deploy/agents.env — сервис агентов (ADR 2026-09-09-0854):
#     AGENT_KEY=<ключ сервиса; его предъявляет всякий, кто зовёт /v1/*>
#     ROUTER_APP_KEY=<то же значение, что APP_KEY_AGENTS в router.env>
#     CONTROL_KEY=<ключ ПОВЕРХНОСТИ УПРАВЛЕНИЯ инструментами агентов
#                  (ADR 2026-09-28-1820). Второй слушатель того же процесса,
#                  порт 8086, свой перечень операций и свой режим отказа.
#                  Это ЕДИНСТВЕННАЯ преграда к нему: сеть решением владельца
#                  не закрывается, и любой контейнер сети default может до
#                  порта достучаться. Поэтому:
#                    — значение не короче 32 знаков (порождается 32 случайными
#                      байтами); строка короче считается обрезанной при
#                      переносе, и поверхность ВЫКЛЮЧАЕТСЯ;
#                    — значение не равно AGENT_KEY и не равно ROUTER_APP_KEY;
#                      совпадение с любым из них — тоже выключение, с записью
#                      control_key_same_as_agent / control_key_same_as_app.
#                  Строки нет — поверхность выключена: она отвечает 503
#                  control_disabled на всё, а /healthz называет причину.
#                  Заводится ВЛАДЕЛЬЦЕМ на самом сервере, значение никуда не
#                  печатается, порядок тот же, что у MCP_KEY ниже:
#                    umask 077; printf 'CONTROL_KEY=%s\n' "$(head -c 32 /dev/urandom | base64 | tr -d '\n')" >> agents.env
#                  Проверка — именами без значений:
#                    grep -o '^[A-Z_]*=' agents.env>
#     MODEL_KEYS=<ИМЕННЫЕ ключи модели без встроенных отказов
#                  (ADR 2026-10-07-1349). Форма — `имя:значение` через
#                  запятую: `mike:XXXX,guest1:YYYY`. Имя — метка для журнала,
#                  суточного потолка и профиля, оно НЕ секрет; секрет —
#                  значение, 24 случайных байта в base64url, без `:` и `,`.
#                  Что даёт ключ: КЛЮЧЕВОЙ профиль, в котором доступна только
#                  модель mac-qwen3-abliterated на ноутбуке владельца, память
#                  профиля выключена, и ничего из него не уходит внешнему
#                  поставщику. Чтение такого профиля требует ключа того же
#                  имени.
#                  Строки нет или она пуста — возможности НЕТ ВОВСЕ: модели
#                  нет в списке, ключевые профили не создаются, существующие
#                  недостижимы как несуществующие, любой заголовок
#                  x-model-key получает 403.
#                  Заводится ВЛАДЕЛЬЦЕМ на самом сервере, значение никуда не
#                  печатается. Первый ключ — одной строкой:
#                    umask 077; printf 'MODEL_KEYS=mike:%s\n' "$(head -c 24 /dev/urandom | base64 | tr -d '\n=' | tr '+/' '-_')" >> agents.env
#                  Второй и далее — правка той же строки руками, имена через
#                  запятую. Отзыв имени = удаление его пары из строки: профиль
#                  этого имени становится недостижим до истечения своих
#                  30 дней, и восстановить его нельзя.
#                  Применение — docker compose up -d agents (обрывает запуски).
#                  Проверка — именами без значений:
#                    grep -o '^[A-Z_]*=' agents.env>
#     MCP_KEY=<то же значение, что MCP_KEY в mcp.env>
#                  Ключ службы MCP: хост инструментов предъявляет его, когда
#                  зовёт её как сервер своего реестра (ADR 2026-09-29-0236,
#                  п. 8). Не новый секрет, а ВТОРАЯ копия существующего —
#                  после mcp.env, по норме копии между env-файлами
#                  (ADR 2026-09-11-1743). Третьей копии (day16.env) больше
#                  нет: консоль дня 16 удалена (ADR 2026-10-20-0737), и
#                  ротация MCP_KEY — это два файла и два контейнера.
#                  Значение при копировании не печатается:
#                    umask 077; grep '^MCP_KEY=' mcp.env >> agents.env
#                  Проверка — именами без значений:
#                    grep -o '^[A-Z_]*=' agents.env
#                  Без него сервис поднимается, но служба MCP отвечает хосту
#                  как несуществующий путь: запись day16 реестра попадает в
#                  unreachable, остальное работает.
#     RAG_KEY=<то же значение, что RAG_KEY в rag.env>
#                  Ключ службы индекса проекта: сервис агентов предъявляет его
#                  как клиент /rag (ADR 2026-10-04-0735, п. 1). Тоже копия, а
#                  не новый секрет. Перечень всех мест жизни этого ключа и
#                  ротация одним проходом — инвариант I-15
#                  (agent_docs/invariants.md) и agent_docs/operations.md,
#                  «Ротация RAG_KEY». Значение при копировании не печатается:
#                    umask 077; grep '^RAG_KEY=' rag.env >> agents.env
#                  Проверка — именами без значений:
#                    grep -o '^[A-Z_]*=' agents.env
#
#   deploy/mcp.env — служба MCP (ADR 2026-09-23-1227). Единственный секрет
#   службы; ключей к моделям и ключа роутера у неё нет. Без файла служба
#   падает на старте, остальные контейнеры поднимаются:
#     MCP_KEY=<длинная случайная строка, вход на https://challenge.zpq.ai/mcp>
#
#   Заводится ДО мержа и на самом сервере, значение при этом никуда не
#   печатается — ни в команду, ни в журнал, ни в транскрипт. Два пути, оба
#   годятся, разницы для службы нет:
#     — значение порождается на самом сервере и сразу уходит в файл:
#         set -C; umask 077; printf 'MCP_KEY=%s\n' "$(head -c 32 /dev/urandom | base64 | tr -d '\n')" > mcp.env; chmod 600 mcp.env
#       (`set -C` не даёт перезаписать уже существующий файл, `umask 077` не
#        даёт создать его читаемым для других);
#     — владелец кладёт своё значение своими руками, тем же порядком, что и
#       прочие секреты сервера.
#   Проверка — именами без значений: grep -o '^[A-Z_]*=' mcp.env
#   Замена значения на своё позже — обычная ротация: перезаписать ОБА файла
#   (mcp.env, agents.env) и `docker compose up -d mcp agents` — иначе хост
#   инструментов предъявляет прежний ключ.
#
#   deploy/rag.env — единица индекса проекта (ADR 2026-09-29-1639, п. 5).
#   Единственный секрет единицы; ключей к моделям и ключа роутера у неё нет:
#     RAG_KEY=<длинная случайная строка, вход на https://challenge.zpq.ai/rag>
#
#   Этот ключ отличается от прочих тем, что живёт не только на сервере: клиент
#   Claude Code ходит в /rag по HTTPS и читает ${RAG_KEY} из окружения ноутбука
#   (файл .mcp.json), а с 2026-10-19 то же значение лежит секретом GitHub для
#   AI-ревью PR. Норма «ключ не покидает сервер» (ADR 2026-09-23-1227, п. 2)
#   нарушена сознательно: без этого клиента с ноутбука нет вовсе. Полный
#   перечень мест и ротация одним проходом — инвариант I-15. Что стоит утечка:
#   не деньги, а суточный потолок вызовов эмбеддинга, то есть ядро общей машины.
#
#   Кладёт владелец, значение нигде не печатается:
#     bash deploy/put-rag-key.sh
#   Проверка — именами без значений: grep -o '^[A-Z_]*=' rag.env
#   Файл обязателен по смыслу: без него единица выходит с кодом 2 и не
#   поднимается (rag/serve.py, main). В compose при этом стоит
#   `required: false` — решение владельца 2026-09-30, чтобы отсутствие файла
#   не валило разбор compose и выкатку ВСЕХ единиц.

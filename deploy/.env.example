# Файл deploy/.env — теги образов. Переписывается workflow деплоя.
# Скопируйте в deploy/.env при первичной настройке.

DAY1_TAG=latest
DAY2_TAG=latest
DAY3_TAG=latest
DAY4_TAG=latest
DAY5_TAG=latest
DAY6_TAG=latest
DAY7_TAG=latest
DAY8_TAG=latest
DAY9_TAG=latest
DAY10_TAG=latest
DAY11_TAG=latest
DAY13_TAG=latest
DAY14_TAG=latest
DAY15_TAG=latest
DAY16_TAG=latest
DAY18_TAG=latest
DAY19_TAG=latest
DAY20_TAG=latest
ROUTER_TAG=latest
AGENTS_TAG=latest
ATLAS_TAG=latest
MCP_TAG=latest
MCPNEWS_TAG=latest
MCPSTORE_TAG=latest

# Секреты приложений живут в отдельных файлах, они в .gitignore
# и создаются на сервере — никогда в репозитории.
#
#   deploy/secrets.env — общий для всех дней, кладётся один раз. Полный
#   состав задаёт deploy/put-secrets.sh, который этот файл и создаёт:
#     ANTHROPIC_API_KEY=<ключ с console.anthropic.com>
#     ANTHROPIC_MODEL=claude-haiku-4-5
#     # Контроль расхода (инварианты I-4..I-6)
#     MAX_SEARCH_USES=4
#     MAX_OUTPUT_TOKENS=2048
#     MAX_DAILY_CALLS=50
#     RATE_LIMIT_PER_MIN=5
#     RATE_LIMIT_PER_HOUR=30
#     CACHE_TTL_HOURS=6
#
#   deploy/dayN.env — только то, что специфично для дня N (обычно не нужен).
#   Переопределяет значения из secrets.env.
#
#   deploy/day5.env — день 5 ходит в роутер, своих ключей к моделям не имеет:
#     ROUTER_APP_KEY=<то же значение, что APP_KEY_DAY5 в router.env>
#
#   deploy/router.env — сервис роутера (ADR 2026-09-08-1748): ключи провайдеров
#   и ключи приложений. Имена переменных задаёт router/config/*.json (secretEnv).
#   Ключи всех трёх облачных провайдеров обязательны: роутер проверяет их на
#   старте и падает на первом отсутствующем, ещё до открытия порта
#   (router/src/config.js, validateProviders). Порядок заведения ключей —
#   agent_docs/operations.md, «Добавить или подключить провайдера»:
#     ANTHROPIC_API_KEY=<ключ с console.anthropic.com>
#     GROQ_API_KEY=<ключ с console.groq.com; страж промптов и генеративные
#                   модели Groq дня 5>
#     KIMI_API_KEY=<ключ с platform.kimi.ai; модели Kimi, которые политика
#                   сама не берёт — только по явному выбору приложения,
#                   ADR 2026-09-15-1448>
#     ROUTER_ADMIN_KEY=<длинная случайная строка, для /v1/spend и /v1/metrics>
#     APP_KEY_SMOKE=<ключ приложения smoke>
#     APP_KEY_DAY5=<ключ приложения day5; он же ROUTER_APP_KEY в day5.env>
#     APP_KEY_AGENTS=<ключ приложения agents; он же ROUTER_APP_KEY в agents.env>
#     APP_KEY_SCHEDULER=<ключ приложения scheduler; он же ROUTER_APP_KEY_SCHEDULER
#                        в agents.env. Отдельное приложение у планировщика
#                        дня 18 (ADR 2026-09-28-0736, п. 6) — потому, что
#                        автономный расход обязан иметь СВОЙ потолок: на
#                        приложении agents ($10 в сутки) ночная сводка тратила
#                        бы бюджет дней 6–15 и была бы в журнале неотличима от
#                        их запросов. Лимиты — router/config/apps.json:
#                        dailyCostUsd 0.5, dailyTokens 500000, класс tool_use.
#                        Ключ заводит ВЛАДЕЛЕЦ до мержа: без него планировщик
#                        выключен по устройству, ручка отвечает 503, модель не
#                        вызывается, и /healthz это называет.>
#   Без файла роутер падает на старте (нет секретов); дни поднимаются как обычно.
#
#   deploy/agents.env — сервис агентов (ADR 2026-09-09-0854):
#     AGENT_KEY=<ключ сервиса; его же предъявляет день 6>
#     ROUTER_APP_KEY=<то же значение, что APP_KEY_AGENTS в router.env>
#     ROUTER_APP_KEY_SCHEDULER=<то же значение, что APP_KEY_SCHEDULER в
#                               router.env. Им и только им оплачиваются
#                               запуски планировщика дня 18. Строки нет —
#                               планировщика нет: ручка /v1/jobs/:job/trigger
#                               отвечает 503 no_scheduler_key, роутер не
#                               вызывается. Это второй из трёх уровней
#                               выключения и единственный, который не зависит
#                               ни от выкатки, ни от ssh.>
#     CONTROL_KEY=<ключ ПОВЕРХНОСТИ УПРАВЛЕНИЯ инструментами агентов
#                  (ADR 2026-09-28-1820). Второй слушатель того же процесса,
#                  порт 8086, свой перечень операций и свой режим отказа.
#                  Это ЕДИНСТВЕННАЯ преграда к нему: сеть решением владельца
#                  не закрывается, и любой контейнер сети default может до
#                  порта достучаться. Поэтому:
#                    — значение не короче 32 знаков (порождается 32 случайными
#                      байтами); строка короче считается обрезанной при
#                      переносе, и поверхность ВЫКЛЮЧАЕТСЯ;
#                    — значение не равно AGENT_KEY и не равно ROUTER_APP_KEY;
#                      совпадение с любым из них — тоже выключение, с записью
#                      control_key_same_as_agent / control_key_same_as_app.
#                  Строки нет — поверхность выключена: она отвечает 503
#                  control_disabled на всё, а /healthz называет причину.
#                  Дни 6–20 при этом работают как прежде.
#                  Заводится ВЛАДЕЛЬЦЕМ на самом сервере, значение никуда не
#                  печатается, порядок тот же, что у MCP_KEY ниже:
#                    umask 077; printf 'CONTROL_KEY=%s\n' "$(head -c 32 /dev/urandom | base64 | tr -d '\n')" >> agents.env
#                  Проверка — именами без значений:
#                    grep -o '^[A-Z_]*=' agents.env
#                  Копия для сервера MCP (mcpagents.env) и процедура ротации —
#                  заход 2 того же ADR, здесь их ещё нет.>
#     MCP_KEY=<то же значение, что MCP_KEY в mcp.env>
#                  Ключ службы MCP дня 16: хост инструментов предъявляет его,
#                  когда зовёт третий сервер (ADR 2026-09-29-0236, п. 8).
#                  Не новый секрет, а ТРЕТЬЯ копия существующего — после
#                  mcp.env и day16.env, по норме копии между env-файлами
#                  (ADR 2026-09-11-1743). Значение при копировании не
#                  печатается, порядок тот же, что у day16.env:
#                    umask 077; grep '^MCP_KEY=' mcp.env >> agents.env
#                  Проверка — именами без значений:
#                    grep -o '^[A-Z_]*=' agents.env
#                  Без него сервис поднимается и дни 6–20 работают, но служба
#                  дня 16 отвечает хосту как несуществующий путь: сервер
#                  day16 попадает в unreachable, и день 20 остаётся с двумя
#                  серверами вместо трёх. Ротация MCP_KEY теперь — три файла
#                  (mcp.env, day16.env, agents.env) и три контейнера.
#
#   deploy/day6.env — день 6 ходит только к агенту, ключа роутера не имеет:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#
#   deploy/day7.env — день 7, тот же ключ агента плюс путь cookie сессии:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#     COOKIE_PATH=/day7/
#
#   deploy/day8.env — день 8, то же самое со своим путём:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#     COOKIE_PATH=/day8/
#
#   deploy/day9.env, deploy/day10.env, deploy/day11.env — дни 9, 10 и 11:
#   тот же ключ сервиса агентов и больше ничего. COOKIE_PATH здесь не нужен —
#   умолчание каждого дня уже его префикс (days/day9/env.js, days/day10/env.js,
#   days/day11/env.js). Без AGENT_KEY день не падает: порт слушает, страница
#   отдаётся, но /healthz отвечает 503, а обращения к агенту идут с пустым
#   Bearer и не проходят. Проверять настройку по /healthz, не по «up»:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#
#   deploy/day13.env — день 13 (ADR 2026-09-21-1747), как дни 9–11: тот же
#   ключ сервиса агентов и больше ничего. COOKIE_PATH здесь не нужен —
#   умолчание дня уже /day13/ (days/day13/env.js). Журнал этапов CSV и срок
#   паузы — переменные сервиса агентов (STAGE_LOG_FILE, PAUSE_TTL_MINUTES),
#   их умолчания в коде верны для прода, объявлять их в deploy не нужно:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#
#   deploy/day14.env — день 14 (ADR 2026-09-22-0827), устроен как день 13:
#   тот же ключ сервиса агентов и больше ничего. COOKIE_PATH не нужен —
#   умолчание дня уже /day14/ (days/day14/env.js). Ключ подписи билетов
#   формулировщика сервис агентов создаёт случайно при старте и нигде не
#   хранит: нового секрета день 14 не заводит:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#
#   deploy/day15.env — день 15 (ADR 2026-09-23-0646), устроен как день 14:
#   тот же ключ сервиса агентов и больше ничего. COOKIE_PATH не нужен —
#   умолчание дня уже /day15/ (days/day15/env.js). Своих секретов день не
#   заводит — файл создаётся копией значения AGENT_KEY из agents.env:
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#
#   deploy/mcp.env — служба MCP (ADR 2026-09-23-1227). Единственный секрет
#   службы; ключей к моделям и ключа роутера у неё нет. Без файла служба
#   падает на старте, остальные контейнеры поднимаются:
#     MCP_KEY=<длинная случайная строка, вход на https://challenge.zpq.ai/mcp>
#
#   Заводится ДО мержа и на самом сервере, значение при этом никуда не
#   печатается — ни в команду, ни в журнал, ни в транскрипт. Два пути, оба
#   годятся, разницы для службы нет:
#     — значение порождается на самом сервере и сразу уходит в файл:
#         set -C; umask 077; printf 'MCP_KEY=%s\n' "$(head -c 32 /dev/urandom | base64 | tr -d '\n')" > mcp.env; chmod 600 mcp.env
#       (`set -C` не даёт перезаписать уже существующий файл, `umask 077` не
#        даёт создать его читаемым для других);
#     — владелец кладёт своё значение своими руками, тем же порядком, что и
#       прочие секреты сервера.
#   Проверка — именами без значений: grep -o '^[A-Z_]*=' mcp.env
#   Замена значения на своё позже — обычная ротация: перезаписать ВСЕ ТРИ файла
#   (mcp.env, day16.env, agents.env) и `docker compose up -d mcp day16 agents`
#   — иначе день 16 или хост инструментов предъявляет прежний ключ.
#
#   deploy/day16.env — день 16 (ADR 2026-09-23-1227, п. 7): консоль ходит в
#   службу MCP по тому же ключу, своих секретов у дня нет. Файл делается
#   копией значения из mcp.env по норме копии между env-файлами
#   (ADR 2026-09-11-1743) — значение при копировании тоже не печатается:
#     set -C; umask 077; grep '^MCP_KEY=' mcp.env > day16.env; chmod 600 day16.env
#     MCP_KEY=<то же значение, что MCP_KEY в mcp.env>
#
#   deploy/day18.env, day19.env, day20.env — дни 18–20 (ADR 2026-09-28-0736).
#   Тот же ключ сервиса агентов, что у дней 6–15, и больше ничего: своих
#   секретов, ключей к моделям и ключа роутера у них нет. Файлы делаются
#   копией значения AGENT_KEY из agents.env, значение не печатается:
#     set -C; umask 077; grep '^AGENT_KEY=' agents.env > day18.env; chmod 600 day18.env
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#   Без файла день поднимается и порт слушает, но запуск не начнётся.
#
#   deploy/cron.env — контейнер времени планировщика (ADR 2026-09-28-0736,
#   п. 6). Своих секретов у него нет: он только дёргает ручку сервиса агентов
#   и предъявляет ей тот же ключ, что дни 6–15. Файл делается копией значения
#   из agents.env по норме копии между env-файлами (ADR 2026-09-11-1743) —
#   значение при копировании не печатается:
#     set -C; umask 077; grep '^AGENT_KEY=' agents.env > cron.env; chmod 600 cron.env
#     AGENT_KEY=<то же значение, что AGENT_KEY в agents.env>
#   Без файла контейнер НЕ поднимается: entrypoint отказывает на старте.
#   Это осознанно — контейнер, который раз в 6 часов получает 401, выглядел бы
#   работающим планировщиком, а ленты сводок просто не было бы.
#   Копия в cron.env требует новой строки в закрытом списке /day-cycle, фаза 9:
#   сегодня он разрешает копировать AGENT_KEY только в dayN.env.
#
#   deploy/rag.env — единица индекса проекта (ADR 2026-09-29-1639, п. 5).
#   Единственный секрет единицы; ключей к моделям и ключа роутера у неё нет:
#     RAG_KEY=<длинная случайная строка, вход на https://challenge.zpq.ai/rag>
#
#   Этот ключ отличается от всех прочих тем, что у него ТРЕТЬЕ место жизни —
#   ноутбук владельца: клиент Claude Code ходит в /rag по HTTPS и читает
#   ${RAG_KEY} из окружения (файл .mcp.json, заход 4). Норма «ключ не покидает
#   сервер» (ADR 2026-09-23-1227, п. 2) нарушена сознательно: без этого клиента
#   с ноутбука нет вовсе. Что стоит утечка: не деньги, а суточный потолок
#   вызовов эмбеддинга, то есть ядро общей машины.
#
#   Кладёт владелец, значение нигде не печатается:
#     bash deploy/put-rag-key.sh
#   Проверка — именами без значений: grep -o '^[A-Z_]*=' rag.env
#   Заходом 3 файл НЕ обязателен: без него единица поднимается, строит индекс и
#   отвечает на /rag/healthz, а публичного маршрута, кроме него, нет. Заходом 4
#   он становится обязательным — по образцу mcp.env.

# Положить или обновить общий файл: bash deploy/put-secrets.sh

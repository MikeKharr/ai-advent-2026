# ==========================
# Безопасность и Логи
# ==========================

# Переменные окружения
.env
.env.*
!.env.example

# Окружение деплоя: теги образов и секреты приложений создаются на сервере
deploy/.env
deploy/*.env
!deploy/.env.example

# Логи
*.log
*.log*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/

# Временные файлы (см. agent_docs/guides/archiving-and-temp.md)
temp/

# Локальное состояние приложения
data/
*.sqlite
*.sqlite-journal

